# Frontend-safe configuration only.
# Vite-exposed variables are visible in the browser bundle.
VITE_FIREBASE_API_KEY=replace_with_firebase_web_config_value
VITE_FIREBASE_AUTH_DOMAIN=replace_with_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace_with_project_id
VITE_FIREBASE_STORAGE_BUCKET=replace_with_bucket_if_used
VITE_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
VITE_FIREBASE_APP_ID=replace_with_app_id

# NEVER put GEMINI_API_KEY or another private server secret in this file
# if the file is loaded by Vite or included in the client bundle.
# Configure Gemini credentials in Firebase/Google Cloud server-side secret management.
