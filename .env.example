# =====================================================================
# Festora AI - Server Environment Variables (Cloud Functions / Node.js)
# NEVER commit production keys or real secrets into git repository.
# =====================================================================

# Port for local backend function server
PORT=5001

# Google Gemini AI API Key (Server-side ONLY - private to Cloud Functions)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Service Account (Server-side ONLY)
FIREBASE_PROJECT_ID=festora-ai-prod

# =====================================================================
# Festora AI - Client Environment Variables (Vite Frontend Application)
# Public client configuration keys embedded in the frontend bundle.
# =====================================================================

# Optional backend URL override (defaults to http://127.0.0.1:5001 for local dev)
VITE_API_BASE_URL=http://127.0.0.1:5001

# Firebase Web App Public Client Configuration
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=festora-ai-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=festora-ai-prod
VITE_FIREBASE_STORAGE_BUCKET=festora-ai-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# Firebase Local Emulator Suite Configuration
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
VITE_FIREBASE_AUTH_PORT=9099
VITE_FIREBASE_FIRESTORE_PORT=8080

