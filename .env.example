# Festora AI - Server Environment Variables
# NEVER commit production keys or real secrets into git repository.
# These variables are accessed ONLY by backend serverless functions (Node.js runtime).

# Port for local backend function server
PORT=5001

# Google Gemini AI API Key (Server-side ONLY)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin Service Account (for private network access to Firestore / Firebase Auth)
FIREBASE_PROJECT_ID=festora-ai-prod
